<t t-name="l10n_ve_lidoo_invoice_report.report_factura_document">
          <style>
            * {
                font-family: 'Consolas', 'Courier New', Courier, monospace !important;
            }

            /* ===== Tamaños de letra de la factura ==========================
               Para agrandar o achicar un bloque completo cambia SOLO el
               valor de pt de la clase correspondiente:

                 .ff-titulo -&gt; tipo de documento (FACTURA / NOTA DE CRÉDITO)
                 .ff-base   -&gt; cabecera (datos del cliente) y tabla de líneas
                 .ff-small  -&gt; coletilla, notas y comentarios
                 .ff-total  -&gt; bloque de totales (queda grande a propósito)
               ============================================================== */
            .ff-titulo { font-size: 12pt !important; }
            .ff-base   { font-size: 12pt !important; }
            .ff-small  { font-size: 12pt !important; }
            .ff-items  { font-size: 12pt !important; }
            .ff-total  { font-size: 12pt !important; }

            /* Tamaños usados únicamente para el contacto especial */
            .ff-special-contact .ff-titulo { font-size: 12pt !important; }
            .ff-special-contact .ff-base   { font-size: 14pt !important; }
            .ff-special-contact .ff-small  { font-size: 10pt !important; }
            .ff-special-contact .ff-items  { font-size: 13pt !important; }
            .ff-special-contact .ff-total  { font-size: 14pt !important; }

            /* ===== Interlineado compacto en toda la factura ================
               line-height ajustado y sin padding vertical en celdas ni
               márgenes entre bloques. Para separar más, subir line-height. */
            .ff-doc, .ff-doc * { line-height: 1.1 !important; }
            .ff-doc td, .ff-doc th { padding-top: 0 !important; padding-bottom: 0 !important; }
            .ff-doc table { margin-top: 0 !important; margin-bottom: 0 !important; border-spacing: 0 !important; }
            .ff-doc p, .ff-doc h3, .ff-doc div { margin-top: 0 !important; margin-bottom: 0 !important; }
            .ff-doc thead th { padding-bottom: 1px !important; }
            .ff-doc #total { margin-top: 2mm !important; }

            /* Las celdas heredan el tamaño de su tabla contenedora */
            .ff-base td, .ff-base th, .ff-base span,
            .ff-total td, .ff-total th, .ff-total span {
                font-size: inherit !important;
            }

            /* ====== FIX ANTI-ENCOGIDO ==================================
               Fuerza todo al ancho del ticket y hace que el texto ENVUELVA
               en vez de que wkhtmltopdf encoja la fuente para que entre.  */
            .ff-doc, .ff-doc .row, .ff-doc .page,
            .ff-doc [class*="col-"] {
                display: block !important;
                width: 100% !important;
                max-width: 100% !important;
                flex: 0 0 100% !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            .ff-doc table { width: 100% !important; max-width: 100% !important; table-layout: fixed !important; }
            .ff-doc td, .ff-doc th, .ff-doc span, .ff-doc strong {
                word-wrap: break-word !important;
                overflow-wrap: break-word !important;
                white-space: normal !important;
            }
            .ff-doc .text-nowrap { white-space: normal !important; }

            /* ====== ALTURA FIJA DE CABECERA + LINEAS ======================
               Reemplaza los <br/> de relleno: la zona se estira hasta
               ff_min_h (mm) cuando hay pocos items y crece cuando hay mas,
               asi los totales siempre quedan a la misma altura.           */
            /* Sin negritas en todo el documento */
            .ff-doc strong, .ff-doc b, .ff-doc th, .ff-doc .fw-bold, .ff-doc .o_line_section {
                font-weight: normal !important;
            }

            .ff-doc .ff-canvas { position: relative !important; overflow: visible !important; }
            .ff-doc .ff-totals-abs { position: absolute !important; }
            .ff-doc #total table { page-break-inside: avoid; }
          </style>

          <!-- Helper de datos lidoo (equivale a la lógica de moneda/igtf/coletilla de v17) -->
          <t t-set="d" t-value="o._l10n_ve_lidoo_factura_data()"/>

          <!-- Reemplaza el RIF por el del contacto real -->
          <t t-set="es_contacto_especial" t-value="o.partner_id.commercial_partner_id.vat == 'J304689713'"/>
          <!-- Altura minima (mm) de la zona cabecera + lineas. Los totales siempre
               arrancan a esta altura como minimo; con mas items el bloque crece.
               Ajustar aqui en vez de agregar <br/>. -->
          <t t-set="ff_min_h" t-value="(105 if es_contacto_especial else 118) if not (o.reversed_entry_id or o.debit_origin_id) else 120"/>

          <div t-att-class="'ff-doc ' + ('ff-special-contact' if es_contacto_especial else '')">
          <div class="row">
            <div class="col-12">
              <h3 t-if="o.state == 'draft'" class="ff-titulo" style="position:absolute;left:10;top:32px;opacity: 0.3;">
                BORRADOR</h3>
              <div class="text-left" t-if="o.state != 'draft'">
                <span class="ff-titulo">
                  <t t-if="o.reversed_entry_id">
                    NOTA DE CRÉDITO
                  </t>
                  <t t-elif="o.debit_origin_id">
                    NOTA DE DÉBITO
                  </t>
                  <t t-else="">
                    FACTURA
                  </t>
                </span>
              </div>
            </div>
          </div>
          <div class="mt-0">
            <!-- Contenedor de altura fija: los totales van en posicion absoluta
                 a ff_min_h desde el tope, sin importar cuantos items haya.  -->
            <div class="page ff-canvas" t-attf-style="position: relative !important; height: {{ ff_min_h + 70 }}mm !important;">
              <div class="ff-fixed">
              <!-- HEADER -->
              <div id="information" class="row mt-0 mb-1">
                <div class="col-auto col-12 mw-100 ff-base" name="header">
                  <!-- Numeración de los documentos -->
                  <t t-if="o.reversed_entry_id">
                    <span>
                      <strong>Nro de nota de crédito:</strong>
                      <t t-if="o.name != '/'" t-out="o.l10n_latam_document_number"/>
                    </span>
                    <br/>
                    <span>
                      <strong>Factura afectada:</strong>
                      <t t-out="o.reversed_entry_id.l10n_latam_document_number"/>
                    </span>
                    <br/>
                    <span t-if="o.reversed_entry_id.l10n_ve_lidoo_control_number">
                      <strong>Nro de control:</strong>
                      <t t-out="o.reversed_entry_id.l10n_ve_lidoo_control_number"/>
                    </span>
                    <br/>
                    <span>
                      <strong>Fecha de la factura:</strong>
                      <t t-if="o.reversed_entry_id.invoice_date" t-out="o.reversed_entry_id.invoice_date.strftime('%d/%m/%Y')"/>
                    </span>
                    <br/>
                    <span>
                      <strong>Total facturado:</strong>
                      <t t-out="o.reversed_entry_id.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                    </span>
                    <br/>
                  </t>
                  <t t-elif="o.debit_origin_id">
                    <span>
                      <strong>Nota de débito:</strong>
                      <t t-if="o.name != '/'" t-out="o.l10n_latam_document_number"/>
                    </span>
                    <br/>
                    <span>
                      <strong>Factura afectada:</strong>
                      <t t-out="o.debit_origin_id.l10n_latam_document_number"/>
                    </span>
                    <span t-if="o.debit_origin_id.l10n_ve_lidoo_control_number">
                      <br/>
                      <strong>Nro de control:</strong>
                      <t t-out="o.debit_origin_id.l10n_ve_lidoo_control_number"/>
                    </span>
                    <br/>
                    <span>
                      <strong>Fecha de la factura:</strong>
                      <t t-out="o.debit_origin_id.invoice_date.strftime('%d/%m/%Y')"/>
                    </span>
                    <br/>
                    <span>
                      <strong>Total facturado:</strong>
                      <t t-out="o.debit_origin_id.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                    </span>
                    <br/>
                  </t>
                  <t t-else="">
                    <span>
                      <strong>Nro de factura:</strong>
                      <t t-if="o.name != '/'" t-out="o.l10n_latam_document_number or 'PENDIENTE'"/>
                    </span>
                    <br/>
                  </t>
                  <span t-if="o.l10n_ve_lidoo_control_number">
                    <strong>Nro de control:</strong>
                    <t t-out="o.l10n_ve_lidoo_control_number"/>
                    <br/>
                  </span>
                  <span t-if="o.invoice_origin">
                    <strong>Pedido: </strong>
                    <t t-out="o.invoice_origin or 'N/A'"/>
                    <br/>
                  </span>
                  <strong>Fecha de emisión:</strong>
                  <t t-if="o.invoice_date" t-out="o.invoice_date.strftime('%d/%m/%Y')"/>
                  <br/>
                  <span>
                    <strong>Razón Social:</strong>
                    <t t-out="o.partner_id.name"/>
                  </span>
                  <br/>
                  <span t-if="o.partner_id.vat">
                    <strong>RIF/CI:</strong>
                    <t t-out="o.partner_id.vat"/>
                  </span>
                  <br/>
                  <span>
                    <strong>Dirección:</strong>
                    <t t-if="o.partner_id.street" t-out="o.partner_id.street"/>
                    <t t-if="o.partner_id.street2" t-out="' - ' + o.partner_id.street2"/>
                    <t t-if="o.partner_id.state_id" t-out="' - ' + o.partner_id.state_id.name"/>
                    <t t-if="o.partner_id.country_id" t-out="' - ' + o.partner_id.country_id.name"/>
                    <t t-if="o.partner_id.city" t-out="' - ' + o.partner_id.city"/>
                  </span>
                  <br/>
                  <span t-if="o.partner_id.phone">
                    <strong>Teléfono:</strong>
                    <t t-out="o.partner_id.phone"/>
                  </span>
                  <t t-set="base_vef" t-value="not d['is_divisa']"/>
                </div>
              </div>
              <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
              <t t-set="show_reference" t-value="d['show_reference']"/>
              <table class="table table-sm table-borderless o_main_table ff-items" name="invoice_line_table">
                <thead>
                  <tr class="border-bottom">
                    <th name="th_code" class="text-start" t-if="o.company_id.l10n_ve_lidoo_show_product_code_free_form">
                      <span>Código</span>
                    </th>
                    <th name="th_description" class="text-start">
                      <span>Descripción</span>
                    </th>
                    <th name="th_priceunit" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                      <span>Precio</span>
                    </th>
                    <th name="th_discount" t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                      <span>Disc.%</span>
                    </th>
                  </tr>
                </thead>
                <tbody class="invoice_tbody">
                  <t t-set="current_subtotal" t-value="0"/>
                  <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
                  <t t-set="current_section" t-value="False"/>
                  <t t-foreach="lines" t-as="line">
                    <t t-if="base_vef">
                      <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                      <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                    </t>
                    <t t-else="">
                      <t t-set="current_subtotal" t-value="current_subtotal + line.l10n_ve_lidoo_reference_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                      <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_included"/>
                    </t>
                    <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                      <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                        <td t-if="o.company_id.l10n_ve_lidoo_show_product_code_free_form">
                          <span t-field="line.product_id.default_code"/>
                        </td>
                        <td name="account_invoice_line_name">
                          <span t-field="line.name" t-options="{'widget': 'text'}"/>
                          <span t-if="line.tax_ids and all(tax.amount == 0.0 for tax in line.tax_ids)">(E)</span>
                        </td>
                        <td class="text-end" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                          <t t-if="line.quantity &gt; 1.0">
                            <span t-field="line.quantity"/>
                            <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                            <span> x </span>
                          </t>
                          <t t-if="base_vef">
                            <span class="text-nowrap" t-field="line.price_unit"/>
                          </t>
                          <t t-else="">
                            <span class="text-nowrap" t-esc="'%.2f' % line.l10n_ve_lidoo_reference_price_unit"/>
                          </t>
                        </td>
                        <td t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                          <span class="text-nowrap" t-field="line.discount"/>
                        </td>
                      </t>
                      <t t-if="line.display_type == 'line_section'">
                        <td colspan="99">
                          <span t-field="line.name" t-options="{'widget': 'text'}"/>
                        </td>
                        <t t-set="current_section" t-value="line"/>
                        <t t-set="current_subtotal" t-value="0"/>
                      </t>
                      <t t-if="line.display_type == 'line_note'">
                        <td colspan="99">
                          <span t-field="line.name" t-options="{'widget': 'text'}"/>
                        </td>
                      </t>
                    </tr>
                    <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                      <tr class="is-subtotal text-end ff-total">
                        <td colspan="99">
                          <strong class="mr16">Subtotal</strong>
                          <span t-out="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                        </td>
                      </tr>
                    </t>
                  </t>
                </tbody>
              </table>
              </div><!-- /.ff-fixed -->
              <!-- Bloque de totales + coletilla anclado a altura fija -->
              <div class="ff-totals-abs" t-attf-style="position: absolute !important; top: {{ ff_min_h }}mm !important; left: 0 !important; right: 0 !important; width: 100% !important;">
              <!-- Tax totals (reescrito para la estructura tax_totals de Odoo 18) -->
              <div class="clearfix mb-1">
                <div id="total" class="row">
                  <div class="col-11 ms-auto">
                    <table class="table table-sm table-borderless ff-total" style="page-break-inside: avoid;">
                      <t t-set="tax_totals" t-value="o.tax_totals"/>

                      <!-- Helper: 2 decimales, punto como separador de miles y coma decimal -->
                      <t t-set="fmt_bs" t-value="lambda v: '{:,.2f}'.format(float(str(v).replace('Bs.D', '').replace('Bs', '').replace('.', '').replace(',', '.').strip() or 0) if isinstance(v, str) else float(v or 0)).replace(',', '|').replace('.', ',').replace('|', '.')"/>

                      <!-- Subtotal (sin impuestos) -->
                      <tr><td colspan="2" style="border-top: 1px solid black;"/></tr>
                      <tr>
                        <td class="text-end" style="vertical-align: middle;">Subtotal</td>
                        <td class="text-end" style="vertical-align: middle;">
                          <span t-out="fmt_bs(tax_totals.get('base_amount_currency', 0))" style="display: inline-block;"/> <span style="display: inline-block;">Bs.</span>
                        </td>
                      </tr>

                      <!-- Impuestos gravados (v18: subtotals -> tax_groups) -->
                      <t t-foreach="tax_totals.get('subtotals', [])" t-as="subt">
                        <t t-foreach="subt.get('tax_groups', [])" t-as="grp">
                          <t t-if="grp.get('tax_amount_currency', 0) &gt; 0">
                            <tr>
                              <td class="text-end" style="vertical-align: middle;">
                                <t t-out="grp.get('group_name', 'Impuestos')"/>
                              </td>
                              <td class="text-end" style="vertical-align: middle;">
                                <span t-out="fmt_bs(grp.get('tax_amount_currency', 0))" style="display: inline-block;"/> <span style="display: inline-block;">Bs.</span>
                              </td>
                            </tr>
                          </t>
                        </t>
                      </t>

                      <!-- IGTF (desde el helper lidoo d; la base se deriva del monto / tasa) -->
                      <t t-if="d.get('igtf')">
                        <tr>
                          <td class="text-end" style="vertical-align: middle;">BI IGTF <t t-out="'%.0f' % d['igtf_rate']"/>%</td>
                          <td class="text-end" style="vertical-align: middle;">
                            <span t-out="fmt_bs(d['igtf_bs'] / (d['igtf_rate'] / 100.0) if d.get('igtf_rate') else 0)" style="display: inline-block;"/> <span style="display: inline-block;">Bs.</span>
                          </td>
                        </tr>
                        <tr>
                          <td class="text-end" style="vertical-align: middle;">IGTF <t t-out="'%.0f' % d['igtf_rate']"/>%</td>
                          <td class="text-end" style="vertical-align: middle;">
                            <span t-out="fmt_bs(d['igtf_bs'])" style="display: inline-block;"/> <span style="display: inline-block;">Bs.</span>
                          </td>
                        </tr>
                      </t>

                      <!-- Total Exento - calcular desde líneas exentas -->
                      <t t-set="exento_total" t-value="0"/>
                      <t t-foreach="o.invoice_line_ids" t-as="line">
                        <t t-if="line.display_type == 'product'">
                          <t t-set="all_taxes_zero" t-value="line.tax_ids and all(tax.amount == 0.0 for tax in line.tax_ids)"/>
                          <t t-if="all_taxes_zero">
                            <t t-set="exento_total" t-value="exento_total + line.price_subtotal"/>
                          </t>
                        </t>
                      </t>
                      <t t-if="exento_total &gt; 0">
                        <tr>
                          <td class="text-end" style="vertical-align: middle;"><strong>EXENTO</strong></td>
                          <td class="text-end" style="vertical-align: middle;">
                            <strong><span t-out="fmt_bs(exento_total)" style="display: inline-block;"/></strong> <strong><span style="display: inline-block;">Bs.</span></strong>
                          </td>
                        </tr>
                      </t>

                      <!-- Línea separadora ANTES del Total -->
                      <tr><td colspan="2" style="border-top: 1px solid black;"/></tr>
                      <!-- Total -->
                      <tr>
                        <td class="text-end" style="vertical-align: middle;"><strong>Total</strong></td>
                        <td class="text-end" style="vertical-align: middle;">
                          <strong><span t-out="fmt_bs(tax_totals.get('total_amount_currency', 0))" style="display: inline-block;"/></strong> <strong><span style="display: inline-block;">Bs.</span></strong>
                        </td>
                      </tr>
                    </table>
                  </div>
                </div>
              </div>
            <!-- Extra information-->
            <div name="coletilla">
              <span t-if="d['show_bcv_note']" class="ff-small">
                A los efectos de lo previsto en el <strong>Art. 25</strong> de la Ley de
                Impuesto al Valor Agregado se expresa el monto total
                de la factura en <strong>USD</strong> calculado a la tasa de cambio
                establecida por BCV de 1US$ por <strong><t t-esc="'%.2f' % d['bcv_note_rate']"/> Bs</strong>
              </span>
            </div>
            <div t-if="not is_html_empty(o.narration)" name="comment" class="ff-small">
              <span t-field="o.narration"/>
            </div>
            <p t-if="not is_html_empty(o.fiscal_position_id.note)" name="note" class="ff-small">
              <span t-field="o.fiscal_position_id.note"/>
            </p>
            <p t-if="o.invoice_incoterm_id" name="incoterm" class="ff-small">
              <strong>Incoterm: </strong><span t-field="o.invoice_incoterm_id.code"/> - <span t-field="o.invoice_incoterm_id.name"/>
            </p>
              </div><!-- /.ff-totals-abs -->
            </div><!-- /.page -->
          </div>
          </div><!-- /.ff-special-contact -->
        </t>
