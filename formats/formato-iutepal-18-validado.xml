 <t t-name="l10n_ve_lidoo_invoice_report.report_factura_document">
    <style>
      * {
        font-family: 'Consolas', 'Courier New', Courier, monospace !important;
      }

      .ff-titulo { font-size: 18pt !important; }
      .ff-base   { font-size: 18pt !important; }
      .ff-small  { font-size: 18pt !important; }
      .ff-items  { font-size: 18pt !important; }
      .ff-total  { font-size: 18pt !important; }

      .ff-doc,
      .ff-doc * {
        line-height: 1.1 !important;
      }

      .ff-doc td,
      .ff-doc th {
        padding-top: 0 !important;
        padding-bottom: 0 !important;
      }

      .ff-doc table {
        margin-top: 0 !important;
        margin-bottom: 0 !important;
        border-spacing: 0 !important;
      }

      .ff-doc p,
      .ff-doc h3,
      .ff-doc div {
        margin-top: 0 !important;
        margin-bottom: 0 !important;
      }

      .ff-doc thead th {
        padding-bottom: 1px !important;
      }

      .ff-doc #total {
        margin-top: 2mm !important;
      }

      .ff-doc .ff-total td[style*="border-top"] {
        padding-top: 1mm !important;
        padding-bottom: 1mm !important;
      }

      .ff-base td,
      .ff-base th,
      .ff-base span,
      .ff-total td,
      .ff-total th,
      .ff-total span {
        font-size: inherit !important;
      }

      .ff-doc,
      .ff-doc .row,
      .ff-doc .page,
      .ff-doc [class*="col-"] {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        flex: 0 0 100% !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      .ff-doc table {
        width: 100% !important;
        max-width: 100% !important;
        table-layout: fixed !important;
      }

      .ff-doc td,
      .ff-doc th,
      .ff-doc span,
      .ff-doc strong {
        word-wrap: break-word !important;
        overflow-wrap: break-word !important;
        white-space: normal !important;
      }

      .ff-doc .text-nowrap {
        white-space: normal !important;
      }

      .ff-doc strong,
      .ff-doc b,
      .ff-doc th,
      .ff-doc .fw-bold,
      .ff-doc .o_line_section {
        font-weight: normal !important;
      }

      .ff-doc .ff-canvas {
        position: relative !important;
        overflow: visible !important;
      }

      .ff-doc .ff-totals-abs {
        position: absolute !important;
      }

      .ff-doc #total table {
        page-break-inside: avoid;
      }

      /* Modo especial para textos largos */
      .ff-doc.ff-special-layout .ff-titulo {
        font-size: 16pt !important;
      }

      .ff-doc.ff-special-layout .ff-base,
      .ff-doc.ff-special-layout .ff-items,
      .ff-doc.ff-special-layout .ff-small,
      .ff-doc.ff-special-layout .ff-total {
        font-size: 15pt !important;
      }

      .ff-doc.ff-special-layout,
      .ff-doc.ff-special-layout * {
        line-height: 1 !important;
      }

      .ff-doc.ff-special-layout td,
      .ff-doc.ff-special-layout th {
        padding-top: 0 !important;
        padding-bottom: 0 !important;
      }

      /* Formato minimo Digitel: el alto minimo del canvas lo pone el
         estilo dinamico (min-height = ff_min_h) para que los subtotales
         queden siempre a la misma altura de pagina */
      .ff-doc.ff-special-layout .ff-canvas {
        height: auto !important;
      }

      .ff-doc.ff-special-layout .ff-totals-abs {
        position: static !important;
        top: auto !important;
        left: auto !important;
        right: auto !important;
        width: 100% !important;
        margin-top: 1mm !important;
      }

      .ff-doc.ff-special-layout .ff-total {
        page-break-inside: avoid !important;
      }

      /* Tres items: baja 1pt respecto al normal (18pt -> 17pt) */
      .ff-doc.ff-three-items .ff-titulo,
      .ff-doc.ff-three-items .ff-base,
      .ff-doc.ff-three-items .ff-items,
      .ff-doc.ff-three-items .ff-small,
      .ff-doc.ff-three-items .ff-total {
        font-size: 17pt !important;
      }
    </style>

    <t t-set="d"
           t-value="o._l10n_ve_lidoo_factura_data()"/>

    <t t-set="ff_min_h"
           t-value="116 if (o.reversed_entry_id or o.debit_origin_id) else 114"/>

    <t t-set="ff_gap_h"
           t-value="20 if (o.reversed_entry_id or o.debit_origin_id) else 35"/>

    <!-- Validación automática -->
    <t t-set="ff_address_text"
           t-value="(o.partner_id.street or '') + ' - ' + (o.partner_id.street2 or '') + ' - ' + (o.partner_id.state_id.name or '') + ' - ' +
           (o.partner_id.country_id.name or '') + ' - ' + (o.partner_id.city or '')"/>

    <t t-set="ff_product_lines"
           t-value="o.invoice_line_ids.filtered(lambda line: line.display_type == 'product')"/>

    <t t-set="ff_special_layout"
           t-value="len(ff_address_text.strip()) &gt; 90 or any(len((line.name or '').replace('\n', ' ').strip()) &gt; 60 for line in ff_product_lines) or
           len(ff_product_lines) &gt; 4"/>

    <t t-set="ff_three_items"
           t-value="len(ff_product_lines) == 3 and not ff_special_layout"/>

    <!-- Sin usar operador % para evitar RPC_ERROR -->
    <!-- Formato minimo Digitel: en layout especial el canvas nunca mide menos
         de ff_min_h, asi los subtotales quedan siempre a la altura de pagina -->
    <t t-set="ff_canvas_style"
           t-value="'position: relative !important; height: auto !important; min-height: ' + str(ff_min_h) + 'mm !important;' if ff_special_layout else
           ('position: relative !important; height: ' + str(ff_min_h + 70) + 'mm !important;')"/>

    <t t-set="ff_totals_style"
           t-value="'position: static !important; top: auto !important; left: auto !important; right: auto !important; width: 100% !important; margin-top:
           1mm !important;' if ff_special_layout else ('position: absolute !important; top: ' + str(ff_min_h) + 'mm !important; left: 0 !important; right:
           0 !important; width: 100% !important;')"/>

    <div t-att-class="'ff-doc ff-special-layout' if ff_special_layout else 'ff-doc ff-three-items' if ff_three_items else 'ff-doc'">

      <div class="row">
        <div class="col-12">

          <h3 t-if="o.state == 'draft'"
              class="ff-titulo"
              style="position:absolute;left:10;top:32px;opacity:0.3;">
            BORRADOR
          </h3>

          <div class="text-left"
               t-if="o.state != 'draft'">

            <span class="ff-titulo">
              <t t-if="o.reversed_entry_id">
                NOTA DE CRÉDITO
              </t>

              <t t-elif="o.debit_origin_id">
                NOTA DE DÉBITO
              </t>

              <t t-else="">
                FACTURA
              </t>
            </span>
          </div>
        </div>
      </div>

      <div class="mt-0">

        <div class="page ff-canvas"
             t-att-style="ff_canvas_style">

          <div class="ff-fixed">

            <!-- CABECERA -->
            <div id="information"
                 class="row mt-0 mb-1">

              <div class="col-auto col-12 mw-100 ff-base"
                   name="header">

                <t t-if="o.reversed_entry_id">

                  <span>
                    <strong>Nro de nota de crédito:</strong>
                    <t t-if="o.name != '/'"
                       t-out="o.l10n_latam_document_number"/>
                  </span>
                  <br/>

                  <span>
                    <strong>Factura afectada:</strong>
                    <t t-out="o.reversed_entry_id.l10n_latam_document_number"/>
                  </span>
                  <br/>

                  <span t-if="o.reversed_entry_id.l10n_ve_lidoo_control_number">
                    <strong>Nro de control:</strong>
                    <t t-out="o.reversed_entry_id.l10n_ve_lidoo_control_number"/>
                  </span>
                  <br/>

                  <span>
                    <strong>Fecha de la factura:</strong>
                    <t t-if="o.reversed_entry_id.invoice_date"
                       t-out="o.reversed_entry_id.invoice_date.strftime('%d/%m/%Y')"/>
                  </span>
                  <br/>

                  <span>
                    <strong>Total facturado:</strong>
                    <t t-out="o.reversed_entry_id.amount_total"
                       t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                  </span>
                  <br/>

                </t>

                <t t-elif="o.debit_origin_id">

                  <span>
                    <strong>Nota de débito:</strong>
                    <t t-if="o.name != '/'"
                       t-out="o.l10n_latam_document_number"/>
                  </span>
                  <br/>

                  <span>
                    <strong>Factura afectada:</strong>
                    <t t-out="o.debit_origin_id.l10n_latam_document_number"/>
                  </span>

                  <span t-if="o.debit_origin_id.l10n_ve_lidoo_control_number">
                    <br/>
                    <strong>Nro de control:</strong>
                    <t t-out="o.debit_origin_id.l10n_ve_lidoo_control_number"/>
                  </span>
                  <br/>

                  <span>
                    <strong>Fecha de la factura:</strong>
                    <t t-out="o.debit_origin_id.invoice_date.strftime('%d/%m/%Y')"/>
                  </span>
                  <br/>

                  <span>
                    <strong>Total facturado:</strong>
                    <t t-out="o.debit_origin_id.amount_total"
                       t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                  </span>
                  <br/>

                </t>

                <t t-else="">

                  <span>
                    <strong>Nro de factura:</strong>
                    <t t-if="o.name != '/'"
                       t-out="o.l10n_latam_document_number or 'PENDIENTE'"/>
                  </span>
                  <br/>

                </t>

                <span t-if="o.l10n_ve_lidoo_control_number">
                  <strong>Nro de control:</strong>
                  <t t-out="o.l10n_ve_lidoo_control_number"/>
                  <br/>
                </span>

                <span t-if="o.invoice_origin">
                  <strong>Pedido:</strong>
                  <t t-out="o.invoice_origin or 'N/A'"/>
                  <br/>
                </span>

                <strong>Fecha de emisión:</strong>
                <t t-if="o.invoice_date"
                   t-out="o.invoice_date.strftime('%d/%m/%Y')"/>
                <br/>

                <span>
                  <strong>Razón Social:</strong>
                  <t t-out="o.partner_id.name"/>
                </span>
                <br/>

                <span t-if="o.partner_id.vat">
                  <strong>RIF/CI:</strong>
                  <t t-out="o.partner_id.vat"/>
                </span>
                <br/>

                <span>
                  <strong>Dirección:</strong>
                  <t t-if="o.partner_id.street"
                     t-out="o.partner_id.street"/>
                  <t t-if="o.partner_id.street2"
                     t-out="' - ' + o.partner_id.street2"/>
                  <t t-if="o.partner_id.state_id"
                     t-out="' - ' + o.partner_id.state_id.name"/>
                  <t t-if="o.partner_id.country_id"
                     t-out="' - ' + o.partner_id.country_id.name"/>
                  <t t-if="o.partner_id.city"
                     t-out="' - ' + o.partner_id.city"/>
                </span>
                <br/>

                <span t-if="o.partner_id.phone">
                  <strong>Teléfono:</strong>
                  <t t-out="o.partner_id.phone"/>
                </span>

                <t t-set="base_vef"
                   t-value="not d['is_divisa']"/>

              </div>
            </div>

            <!-- LÍNEAS -->
            <t t-set="display_discount"
               t-value="any(l.discount for l in o.invoice_line_ids)"/>

            <t t-set="show_reference"
               t-value="d['show_reference']"/>

            <table class="table table-sm table-borderless o_main_table ff-items"
                   name="invoice_line_table">

              <thead>
                <tr class="border-bottom">

                  <th name="th_description"
                      class="text-start">
                    <span>Descripción</span>
                  </th>

                  <th name="th_priceunit"
                      t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                    <span>Precio</span>
                  </th>

                  <th name="th_discount"
                      t-if="display_discount"
                      t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                    <span>Disc.%</span>
                  </th>

                </tr>
              </thead>

              <tbody class="invoice_tbody">

                <t t-set="current_subtotal"
                   t-value="0"/>

                <t t-set="lines"
                   t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>

                <t t-set="current_section"
                   t-value="False"/>

                <t t-foreach="lines"
                   t-as="line">

                  <t t-if="base_vef">

                    <t t-set="current_subtotal"
                       t-value="current_subtotal + line.price_subtotal"
                       groups="account.group_show_line_subtotals_tax_excluded"/>

                    <t t-set="current_subtotal"
                       t-value="current_subtotal + line.price_total"
                       groups="account.group_show_line_subtotals_tax_included"/>

                  </t>

                  <t t-else="">

                    <t t-set="current_subtotal"
                       t-value="current_subtotal + line.l10n_ve_lidoo_reference_subtotal"
                       groups="account.group_show_line_subtotals_tax_excluded"/>

                    <t t-set="current_subtotal"
                       t-value="current_subtotal + line.price_subtotal"
                       groups="account.group_show_line_subtotals_tax_included"/>

                  </t>

                  <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if
                  line.display_type == 'line_note' else ''">

                    <t t-if="line.display_type == 'product'"
                       name="account_invoice_line_accountable">

                      <td name="account_invoice_line_name">
                        <span t-field="line.name"
                              t-options="{'widget': 'text'}"/>

                        <span t-if="line.tax_ids and all(tax.amount == 0.0 for tax in line.tax_ids)">
                          (E)
                        </span>
                      </td>

                      <td class="text-end"
                          t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">

                        <span t-field="line.quantity"/>
                        <span> x </span>

                        <t t-if="base_vef">
                          <span class="text-nowrap"
                                t-field="line.price_unit"/>
                        </t>

                        <t t-else="">
                          <span class="text-nowrap"
                                t-esc="'{:.2f}'.format(line.l10n_ve_lidoo_reference_price_unit)"/>
                        </t>

                      </td>

                      <td t-if="display_discount"
                          t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                        <span class="text-nowrap"
                              t-field="line.discount"/>
                      </td>

                    </t>

                    <t t-if="line.display_type == 'line_section'">

                      <td colspan="99">
                        <span t-field="line.name"
                              t-options="{'widget': 'text'}"/>
                      </td>

                      <t t-set="current_section"
                         t-value="line"/>

                      <t t-set="current_subtotal"
                         t-value="0"/>

                    </t>

                    <t t-if="line.display_type == 'line_note'">

                      <td colspan="99">
                        <span t-field="line.name"
                              t-options="{'widget': 'text'}"/>
                      </td>

                    </t>

                  </tr>

                  <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">

                    <tr class="is-subtotal text-end ff-total">
                      <td colspan="99">
                        <strong class="mr16">Subtotal</strong>
                        <span t-out="current_subtotal"
                              t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                      </td>
                    </tr>

                  </t>

                </t>
              </tbody>
            </table>

          </div>

          <!-- Espacio en blanco de separacion entre descripcion y totales:
               35mm en factura, 20mm en nota de credito (y debito) -->
          <div t-att-style="'height: ' + str(ff_gap_h) + 'mm !important;'">&#160;</div>

          <!-- TOTALES -->
          <div class="ff-totals-abs"
               t-att-style="ff_totals_style">

            <div class="clearfix mb-1">

              <div id="total"
                   class="row">

                <div class="col-11 ms-auto">

                  <table class="table table-sm table-borderless ff-total"
                         style="page-break-inside: avoid;">

                    <t t-set="tax_totals"
                       t-value="o.tax_totals"/>

                    <t t-set="fmt_bs"
                       t-value="lambda v: '{:,.2f}'.format(float(str(v).replace('Bs.D', '').replace('Bs', '').replace('.', '').replace(',', '.').strip() or
                       0) if isinstance(v, str) else float(v or 0)).replace(',', '|').replace('.', ',').replace('|', '.')"/>

                    <!-- SUBTOTAL -->
                    <tr>
                      <td colspan="2"
                          style="border-top: 1px solid black;"/>
                    </tr>

                    <tr>
                      <td class="text-end"
                          style="vertical-align: middle;">
                        Subtotal
                      </td>

                      <td class="text-end"
                          style="vertical-align: middle;">
                        <span t-out="fmt_bs(tax_totals.get('base_amount_currency', 0))"
                              style="display: inline-block;"/>
                        <span style="display: inline-block;">Bs.</span>
                      </td>
                    </tr>

                    <!-- BI IGTF -->
                    <tr>
                      <td class="text-end"
                          style="vertical-align: middle;">
                        BI IGTF
                        <t t-out="'{:.0f}'.format(d.get('igtf_rate') or 0.0)"/>%
                      </td>

                      <td class="text-end"
                          style="vertical-align: middle;">
                        <span t-out="fmt_bs(d.get('igtf_base_bs', 0.0))"
                              style="display: inline-block;"/>
                        <span style="display: inline-block;">Bs.</span>
                      </td>
                    </tr>

                    <!-- IGTF -->
                    <tr>
                      <td class="text-end"
                          style="vertical-align: middle;">
                        IGTF
                        <t t-out="'{:.0f}'.format(d.get('igtf_rate') or 0.0)"/>%
                      </td>

                      <td class="text-end"
                          style="vertical-align: middle;">
                        <span t-out="fmt_bs(d.get('igtf_bs', 0.0))"
                              style="display: inline-block;"/>
                        <span style="display: inline-block;">Bs.</span>
                      </td>
                    </tr>

                    <!-- IVA -->
                    <t t-foreach="tax_totals.get('subtotals', [])"
                       t-as="subt">

                      <t t-foreach="subt.get('tax_groups', [])"
                         t-as="grp">

                        <t t-if="grp.get('tax_amount_currency', 0) &gt; 0">

                          <tr>
                            <td class="text-end"
                                style="vertical-align: middle;">
                              <t t-out="grp.get('group_name', 'Impuestos')"/>
                            </td>

                            <td class="text-end"
                                style="vertical-align: middle;">
                              <span t-out="fmt_bs(grp.get('tax_amount_currency', 0))"
                                    style="display: inline-block;"/>
                              <span style="display: inline-block;">Bs.</span>
                            </td>
                          </tr>

                        </t>
                      </t>
                    </t>

                    <!-- EXENTO -->
                    <t t-set="exento_total"
                       t-value="0"/>

                    <t t-foreach="o.invoice_line_ids"
                       t-as="line">

                      <t t-if="line.display_type == 'product'">

                        <t t-set="all_taxes_zero"
                           t-value="line.tax_ids and all(tax.amount == 0.0 for tax in line.tax_ids)"/>

                        <t t-if="all_taxes_zero">
                          <t t-set="exento_total"
                             t-value="exento_total + line.price_subtotal"/>
                        </t>

                      </t>
                    </t>

                    <t t-if="exento_total &gt; 0">

                      <tr>
                        <td class="text-end"
                            style="vertical-align: middle;">
                          <strong>EXENTO</strong>
                        </td>

                        <td class="text-end"
                            style="vertical-align: middle;">
                          <strong>
                            <span t-out="fmt_bs(exento_total)"
                                  style="display: inline-block;"/>
                          </strong>
                          <strong>
                            <span style="display: inline-block;">Bs.</span>
                          </strong>
                        </td>
                      </tr>

                    </t>

                    <!-- TOTAL -->
                    <tr>
                      <td colspan="2"
                          style="border-top: 1px solid black;"/>
                    </tr>

                    <tr>
                      <td class="text-end"
                          style="vertical-align: middle;">
                        <strong>Total</strong>
                      </td>

                      <td class="text-end"
                          style="vertical-align: middle;">
                        <strong>
                          <span t-out="fmt_bs(tax_totals.get('total_amount_currency', 0))"
                                style="display: inline-block;"/>
                        </strong>
                        <strong>
                          <span style="display: inline-block;">Bs.</span>
                        </strong>
                      </td>
                    </tr>

                  </table>
                </div>
              </div>
            </div>

            <!-- COLETILLA -->
            <div name="coletilla">

              <span t-if="d['show_bcv_note']"
                    class="ff-small">

                A los efectos de lo previsto en el
                <strong>Art. 25</strong> de la Ley de Impuesto al Valor Agregado
                se expresa el monto total de la factura en <strong>USD</strong>
                calculado a la tasa de cambio establecida por BCV de 1US$ por
                <strong>
                  <t t-esc="'{:.2f}'.format(d['bcv_note_rate'])"/> Bs
                </strong>

              </span>
            </div>

            <div t-if="not is_html_empty(o.narration)"
                 name="comment"
                 class="ff-small">
              <span t-field="o.narration"/>
            </div>

            <p t-if="not is_html_empty(o.fiscal_position_id.note)"
               name="note"
               class="ff-small">
              <span t-field="o.fiscal_position_id.note"/>
            </p>

            <p t-if="o.invoice_incoterm_id"
               name="incoterm"
               class="ff-small">
              <strong>Incoterm:</strong>
              <span t-field="o.invoice_incoterm_id.code"/>
              -
              <span t-field="o.invoice_incoterm_id.name"/>
            </p>

          </div>
        </div>
      </div>
    </div>
  </t>
