<t t-name="l10n_ve_lidoo_invoice_report.report_factura_document">
    <style>
        .ff-doc * {
            font-family: inherit !important;
        }
        /* =========================================================
           IMPORTANTE:
           EL XML NO DEFINE:
           - ancho del papel
           - alto del papel
           - márgenes del papel
           - DPI
           - orientación
           TODO ESO LO CONTROLA FORMA LIBRE / PAPERFORMAT
           ========================================================= */
        .ff-doc,
        .ff-doc * {
            line-height: 1.05 !important;
            box-sizing: border-box !important;
        }
        .ff-doc {
            width: 100% !important;
            max-width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        .ff-doc .page,
        .ff-doc .ff-canvas {
            width: 100% !important;
            max-width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow: visible !important;
        }
        .ff-doc .ff-canvas {
            position: relative !important;
        }
        .ff-doc .ff-totals {
            position: absolute !important;
            bottom: 0 !important;
            left: 0 !important;
            width: 100% !important;
            page-break-inside: avoid !important;
        }
        .ff-doc .row {
            margin-left: 0 !important;
            margin-right: 0 !important;
        }
        .ff-doc [class*="col-"] {
            padding-left: 0 !important;
            padding-right: 0 !important;
        }
        .ff-doc table {
            width: 100% !important;
            max-width: 100% !important;
            margin-top: 0 !important;
            margin-bottom: 0 !important;
            border-spacing: 0 !important;
        }
        .ff-doc td,
        .ff-doc th {
            padding-top: 0 !important;
            padding-bottom: 0 !important;
        }
        .ff-doc p,
        .ff-doc h3 {
            margin-top: 0 !important;
            margin-bottom: 0 !important;
        }
        .ff-doc strong,
        .ff-doc b,
        .ff-doc th,
        .ff-doc .fw-bold,
        .ff-doc .o_line_section {
            font-weight: normal !important;
        }
        .ff-doc #total {
            margin-top: 0 !important;
        }
        .ff-doc #total table {
            page-break-inside: avoid !important;
        }
        .ff-doc .ff-total {
            page-break-inside: avoid !important;
        }
        .ff-doc .ff-total td[style*="border-top"] {
            padding-top: 1mm !important;
            padding-bottom: 1mm !important;
        }
        /*
         * No se define font-size aquí.
         *
         * La fuente/tamaño debe venir de:
         * Forma Libre — configuración de impresión
         */
    </style>
    <!-- =========================================================
         CONFIGURACIÓN FORMA LIBRE
         ========================================================= -->
    <t t-set="cfg" t-value="o.env['l10n_ve_lidoo.report.config']._resolve(o.company_id, 'forma_libre')"/>
    <t t-if="cfg.get('font_css')">
        <t t-call="l10n_ve_lidoo_font.report_font_style"/>
    </t>
    <t t-set="d" t-value="o._l10n_ve_lidoo_factura_data()"/>
    <!-- Fuente configurada en Forma Libre -->
    <t t-set="ff_font_family" t-value="cfg.get('font_family') or 'Consolas'"/>
    <!-- Tamaño configurado en Forma Libre -->
    <t t-set="ff_font_size_pt" t-value="cfg.get('font_size_pt') or 13.0"/>
    <!-- Altura imprimible efectiva del formato de papel seleccionado -->
    <t t-set="ff_paperformat" t-value="o.env['report.paperformat'].browse(cfg.get('paperformat_id')) if cfg.get('paperformat_id') else False"/>
    <t t-set="ff_printable_height_mm" t-value="max((cfg.get('paperformat_height_mm') or 0.0) - ((ff_paperformat.margin_top + ff_paperformat.margin_bottom) if ff_paperformat else 0.0), 0.0)"/>
    <t t-set="ff_printable_width_mm" t-value="max((cfg.get('paperformat_width_mm') or 0.0) - ((ff_paperformat.margin_left + ff_paperformat.margin_right) if ff_paperformat else 0.0), 0.0)"/>
    <t t-set="ff_printable_width_css" t-value="str(ff_printable_width_mm) + 'mm' if ff_printable_width_mm else '100%'"/>
    <!-- =========================================================
         TIPO DE DOCUMENTO
         ========================================================= -->
    <t t-set="ff_is_factura" t-value="not (o.reversed_entry_id or o.debit_origin_id)"/>
    <!-- =========================================================
         PRODUCTOS
         ========================================================= -->
    <t t-set="ff_product_lines" t-value="o.invoice_line_ids.filtered(lambda line: line.display_type == 'product')"/>
    <!-- =========================================================
         EXCEPCIÓN
         SOLO:
         FACTURA + RIF J304689713
         NO:
         - ancho del papel
         - alto del papel
         - cantidad de productos
         - dirección
         - descripción
         ========================================================= -->
    <t t-set="ff_special_layout" t-value="ff_is_factura and (o.partner_id.vat or '').replace('-', '').replace(' ', '').upper() == 'J304689713'"/>
    <!-- =========================================================
         DOCUMENTO
         El font-size viene de configuración.
         ========================================================= -->
    <div class="ff-doc" t-att-data-font-size-pt="ff_font_size_pt" t-attf-style="font-family: '{{ ff_font_family }}', 'Courier New', Courier, monospace !important; font-size: {{ ff_font_size_pt }}pt !important; width: {{ ff_printable_width_css }} !important; max-width: {{ ff_printable_width_css }} !important;">
        <!-- =====================================================
             TÍTULO
             ===================================================== -->
        <div class="page ff-canvas" t-attf-style="height: {{ ff_printable_height_mm }}mm !important; min-height: {{ ff_printable_height_mm }}mm !important;">
        <div class="row">
            <div class="col-12">
                <h3 t-if="o.state == 'draft'" class="ff-titulo" style="position:absolute; left:10px; top:32px; opacity:0.3; font-size:inherit;">
                    BORRADOR
                </h3>
                <div class="text-left" t-if="o.state != 'draft'">
                    <span class="ff-titulo" style="font-size:inherit;">
                        <t t-if="o.reversed_entry_id">
                            NOTA DE CRÉDITO
                        </t>
                        <t t-elif="o.debit_origin_id">
                            NOTA DE DÉBITO
                        </t>
                        <t t-else="">
                            FACTURA
                        </t>
                    </span>
                </div>
            </div>
        </div>
        <!-- =====================================================
             CONTENIDO
             EL RESUMEN FINAL SE ALINEA AL FONDO DEL FORMATO
             ===================================================== -->
        <div class="mt-0 ff-content-flow">
                <!-- =================================================
                     CABECERA
                     ================================================= -->
                <div id="information" class="row mt-0 mb-1">
                    <div class="col-auto col-12 mw-100 ff-base" name="header" style="font-size:inherit;">
                        <!-- =========================================
                             NOTA DE CRÉDITO
                             CONSERVA CONTROL
                             ========================================= -->
                        <t t-if="o.reversed_entry_id">
                            <span>
                                <strong>Nro de nota de crédito:</strong>
                                <t t-if="o.name != '/'" t-out="o.l10n_latam_document_number"/>
                            </span>
                            <br/>
                            <span>
                                <strong>Factura afectada:</strong>
                                <t t-out="o.reversed_entry_id.l10n_latam_document_number"/>
                            </span>
                            <br/>
                            <span t-if="o.reversed_entry_id.l10n_ve_lidoo_control_number">
                                <strong>Nro de control:</strong>
                                <t t-out="o.reversed_entry_id.l10n_ve_lidoo_control_number"/>
                            </span>
                            <br/>
                            <span>
                                <strong>Fecha de la factura:</strong>
                                <t t-if="o.reversed_entry_id.invoice_date" t-out="o.reversed_entry_id.invoice_date.strftime('%d/%m/%Y')"/>
                            </span>
                            <br/>
                            <span>
                                <strong>Total facturado:</strong>
                                <t t-out="o.reversed_entry_id.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                            </span>
                            <br/>
                        </t>
                        <!-- =========================================
                             NOTA DE DÉBITO
                             CONSERVA CONTROL
                             ========================================= -->
                        <t t-elif="o.debit_origin_id">
                            <span>
                                <strong>Nota de débito:</strong>
                                <t t-if="o.name != '/'" t-out="o.l10n_latam_document_number"/>
                            </span>
                            <br/>
                            <span>
                                <strong>Factura afectada:</strong>
                                <t t-out="o.debit_origin_id.l10n_latam_document_number"/>
                            </span>
                            <span t-if="o.debit_origin_id.l10n_ve_lidoo_control_number">
                                <br/>
                                <strong>Nro de control:</strong>
                                <t t-out="o.debit_origin_id.l10n_ve_lidoo_control_number"/>
                            </span>
                            <br/>
                            <span>
                                <strong>Fecha de la factura:</strong>
                                <t t-if="o.debit_origin_id.invoice_date" t-out="o.debit_origin_id.invoice_date.strftime('%d/%m/%Y')"/>
                            </span>
                            <br/>
                            <span>
                                <strong>Total facturado:</strong>
                                <t t-out="o.debit_origin_id.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                            </span>
                            <br/>
                        </t>
                        <!-- =========================================
                             FACTURA
                             SIN NÚMERO DE CONTROL
                             ========================================= -->
                        <t t-else="">
                            <span>
                                <strong>Nro de factura:</strong>
                                <t t-if="o.name != '/'" t-out="o.l10n_latam_document_number or 'PENDIENTE'"/>
                            </span>
                            <br/>
                        </t>
                        <!-- PEDIDO -->
                        <span t-if="o.invoice_origin">
                            <strong>Pedido:</strong>
                            <t t-out="o.invoice_origin or 'N/A'"/>
                            <br/>
                        </span>
                        <!-- FECHA -->
                        <strong>Fecha de emisión:</strong>
                        <t t-if="o.invoice_date" t-out="o.invoice_date.strftime('%d/%m/%Y')"/>
                        <br/>
                        <!-- CLIENTE -->
                        <span>
                            <strong>Razón Social:</strong>
                            <t t-out="o.partner_id.name"/>
                        </span>
                        <br/>
                        <!-- RIF -->
                        <span t-if="o.partner_id.vat">
                            <strong>RIF/CI:</strong>
                            <t t-out="o.partner_id.vat"/>
                        </span>
                        <br/>
                        <!-- DIRECCIÓN -->
                        <span>
                            <strong>Dirección:</strong>
                            <t t-if="o.partner_id.street" t-out="o.partner_id.street"/>
                            <t t-if="o.partner_id.street2" t-out="' - ' + o.partner_id.street2"/>
                            <t t-if="o.partner_id.state_id" t-out="' - ' + o.partner_id.state_id.name"/>
                            <t t-if="o.partner_id.country_id" t-out="' - ' + o.partner_id.country_id.name"/>
                            <t t-if="o.partner_id.city" t-out="' - ' + o.partner_id.city"/>
                        </span>
                        <br/>
                        <!-- TELÉFONO -->
                        <span t-if="o.partner_id.phone">
                            <strong>Teléfono:</strong>
                            <t t-out="o.partner_id.phone"/>
                        </span>
                        <t t-set="base_vef" t-value="not d['is_divisa']"/>
                    </div>
                </div>
                <!-- =================================================
                     PRODUCTOS
                     ================================================= -->
                <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
                <t t-set="show_reference" t-value="d['show_reference']"/>
                    <table class="table table-sm table-borderless o_main_table ff-items" name="invoice_line_table" style="font-size:inherit;">
                    <thead>
                        <tr class="border-bottom">
                            <th name="th_description" class="text-start">
                                <span>Descripción</span>
                            </th>
                            <th name="th_priceunit" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                <span>Precio</span>
                            </th>
                            <th name="th_discount" t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                <span>Disc.%</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="invoice_tbody">
                        <t t-set="current_subtotal" t-value="0"/>
                        <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
                        <t t-set="current_section" t-value="False"/>
                        <t t-foreach="lines" t-as="line">
                            <!-- DESCRIPCIÓN -->
                            <t t-set="ff_code_parts" t-value="(line.name or '').split(']')"/>
                            <t t-set="ff_line_name" t-value="''.join([(q.split('[', 1)[0] if ('[' in q and q.split('[', 1)[1].strip().isdigit()) else q + ']') for q in ff_code_parts[:-1]] + [ff_code_parts[-1]]).strip()"/>
                            <!-- CANTIDAD -->
                            <t t-set="ff_qty" t-value="str(int(line.quantity or 0)) if (line.quantity or 0) == int(line.quantity or 0) else str(line.quantity or 0)"/>
                            <!-- SUBTOTAL -->
                            <t t-if="base_vef">
                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                            </t>
                            <t t-else="">
                                <t t-set="current_subtotal" t-value="current_subtotal + line.l10n_ve_lidoo_reference_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_included"/>
                            </t>
                            <tr t-att-class="'bg-200 o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                                    <td name="account_invoice_line_name">
                                        <span t-esc="ff_line_name" t-options="{'widget': 'text'}"/>
                                        <span t-if="line.tax_ids and all(tax.amount == 0.0 for tax in line.tax_ids)">
                                            (E)
                                        </span>
                                    </td>
                                    <td t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                        <span t-esc="ff_qty"/>
                                        <span> x </span>
                                        <t t-if="base_vef">
                                            <span t-field="line.price_unit"/>
                                        </t>
                                        <t t-else="">
                                            <span t-esc="'{:.2f}'.format(line.l10n_ve_lidoo_reference_price_unit)"/>
                                        </t>
                                    </td>
                                    <td t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                        <span t-field="line.discount"/>
                                    </td>
                                </t>
                                <!-- SECCIÓN -->
                                <t t-if="line.display_type == 'line_section'">
                                    <td colspan="99">
                                        <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                    </td>
                                    <t t-set="current_section" t-value="line"/>
                                    <t t-set="current_subtotal" t-value="0"/>
                                </t>
                                <!-- NOTA -->
                                <t t-if="line.display_type == 'line_note'">
                                    <td colspan="99">
                                        <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                    </td>
                                </t>
                            </tr>
                            <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                                <tr class="is-subtotal text-end ff-total">
                                    <td colspan="99">
                                        <span class="mr16">
                                            Subtotal
                                        </span>
                                        <span t-out="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>
                <!-- =================================================
                     TOTALES
                     EL BLOQUE COMPLETO, INCLUIDA LA COLETILLA, SE
                     ANCLA AL FONDO DEL ÁREA IMPRIMIBLE.
                     ================================================= -->
                <div class="ff-totals">
                    <div class="clearfix mb-1">
                        <div id="total" class="row">
                            <div class="col-11 ms-auto">
                                <table class="table table-sm table-borderless ff-total" style="font-size:inherit; page-break-inside:avoid;">
                                    <t t-set="tax_totals" t-value="o.tax_totals"/>
                                    <t t-set="fmt_bs" t-value="lambda v: '{:,.2f}'.format(float(str(v).replace('Bs.D', '').replace('Bs', '').replace('.', '').replace(',', '.').strip() or 0) if isinstance(v, str) else float(v or 0)).replace(',', '|').replace('.', ',').replace('|', '.')"/>
                                    <!-- SUBTOTAL -->
                                    <tr>
                                        <td colspan="2" style="border-top:1px solid black;"/>
                                    </tr>
                                    <tr>
                                        <td class="text-end">
                                            Subtotal
                                        </td>
                                        <td class="text-end">
                                            <span t-out="fmt_bs(tax_totals.get('base_amount_currency', 0))"/>
                                            <span> Bs.</span>
                                        </td>
                                    </tr>
                                    <!-- BI IGTF -->
                                    <tr>
                                        <td class="text-end">
                                            BI IGTF
                                            <t t-out="'{:.0f}'.format(d.get('igtf_rate') or 0.0)"/>%
                                        </td>
                                        <td class="text-end">
                                            <span t-out="fmt_bs(d.get('igtf_base_bs', 0.0))"/>
                                            <span> Bs.</span>
                                        </td>
                                    </tr>
                                    <!-- IGTF -->
                                    <tr>
                                        <td class="text-end">
                                            IGTF
                                            <t t-out="'{:.0f}'.format(d.get('igtf_rate') or 0.0)"/>%
                                        </td>
                                        <td class="text-end">
                                            <span t-out="fmt_bs(d.get('igtf_bs', 0.0))"/>
                                            <span> Bs.</span>
                                        </td>
                                    </tr>
                                    <!-- IVA -->
                                    <t t-foreach="tax_totals.get('subtotals', [])" t-as="subt">
                                        <t t-foreach="subt.get('tax_groups', [])" t-as="grp">
                                            <t t-if="grp.get('tax_amount_currency', 0) &gt; 0">
                                                <tr>
                                                    <td class="text-end">
                                                        <t t-out="grp.get('group_name', 'Impuestos')"/>
                                                    </td>
                                                    <td class="text-end">
                                                        <span t-out="fmt_bs(grp.get('tax_amount_currency', 0))"/>
                                                        <span> Bs.</span>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                    </t>
                                    <!-- EXENTO -->
                                    <t t-set="exento_total" t-value="0"/>
                                    <t t-foreach="o.invoice_line_ids" t-as="line">
                                        <t t-if="line.display_type == 'product'">
                                            <t t-set="all_taxes_zero" t-value="line.tax_ids and all(tax.amount == 0.0 for tax in line.tax_ids)"/>
                                            <t t-if="all_taxes_zero">
                                                <t t-set="exento_total" t-value="exento_total + line.price_subtotal"/>
                                            </t>
                                        </t>
                                    </t>
                                    <t t-if="exento_total &gt; 0">
                                        <tr>
                                            <td class="text-end">
                                                EXENTO
                                            </td>
                                            <td class="text-end">
                                                <span t-out="fmt_bs(exento_total)"/>
                                                <span> Bs.</span>
                                            </td>
                                        </tr>
                                    </t>
                                    <!-- TOTAL -->
                                    <tr>
                                        <td colspan="2" style="border-top:1px solid black;"/>
                                    </tr>
                                    <tr>
                                        <td class="text-end">
                                            Total
                                        </td>
                                        <td class="text-end">
                                            <span t-out="fmt_bs(tax_totals.get('total_amount_currency', 0))"/>
                                            <span> Bs.</span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                    <!-- =================================================
                         COLETILLA
                         ================================================= -->
                    <div name="coletilla">
                        <span t-if="d['show_bcv_note']" class="ff-small" style="font-size:inherit;">
                            A los efectos de lo previsto en el
                            <strong>Art. 25</strong>
                            de la Ley de Impuesto al Valor Agregado
                            se expresa el monto total de la factura en
                            <strong>USD</strong>
                            calculado a la tasa de cambio establecida por BCV
                            de 1US$ por
                            <strong>
                                <t t-esc="'{:.2f}'.format(d['bcv_note_rate'])"/>
                                Bs
                            </strong>
                        </span>
                    </div>
                    <!-- NARRACIÓN -->
                    <div t-if="not is_html_empty(o.narration)" name="comment" class="ff-small" style="font-size:inherit;">
                        <span t-field="o.narration"/>
                    </div>
                    <!-- POSICIÓN FISCAL -->
                    <p t-if="o.fiscal_position_id and not is_html_empty(o.fiscal_position_id.note)" name="note" class="ff-small" style="font-size:inherit;">
                        <span t-field="o.fiscal_position_id.note"/>
                    </p>
                    <!-- INCOTERM -->
                    <p t-if="o.invoice_incoterm_id" name="incoterm" class="ff-small" style="font-size:inherit;">
                        <strong>Incoterm:</strong>
                        <span t-field="o.invoice_incoterm_id.code"/>
                        -
                        <span t-field="o.invoice_incoterm_id.name"/>
                    </p>
                </div>
        </div>
        </div>
    </div>
    <script type="text/javascript">
        (function () {
            function fitInvoice(doc) {
                var items = doc.querySelector('.ff-items');
                var totals = doc.querySelector('.ff-totals');
                var configuredSize = parseFloat(doc.getAttribute('data-font-size-pt'));
                var minSize;
                var size;
                var gap = 8; // Aproximadamente 2 mm entre productos y totales.
                if (!items || !totals || !configuredSize) {
                    return;
                }
                minSize = Math.min(configuredSize, 8);
                size = configuredSize;
                totals.style.setProperty('position', 'absolute', 'important');
                doc.style.setProperty('font-size', size + 'pt', 'important');
                // Bajar la fuente GLOBAL solo mientras los productos invadan el pie.
                while (items.getBoundingClientRect().bottom + gap &gt; totals.getBoundingClientRect().top
                       &amp;&amp; size &gt; minSize) {
                    size = Math.max(minSize, size - 0.25);
                    doc.style.setProperty('font-size', size + 'pt', 'important');
                }
                // Si ni siquiera a 8 pt cabe, evitar el solape y dejar paginar.
                if (items.getBoundingClientRect().bottom + gap &gt; totals.getBoundingClientRect().top) {
                    totals.style.setProperty('position', 'static', 'important');
                }
            }
            function fitAllInvoices() {
                var documents = document.querySelectorAll('.ff-doc');
                var i;
                for (i = 0; i &lt; documents.length; i += 1) {
                    fitInvoice(documents[i]);
                }
            }
            fitAllInvoices();
